# 安全示例配置。请复制为 cluster.env 后按实际环境修改。
# 本文件仅允许 KEY=value；不执行 shell 展开、命令替换或 source。

CLUSTER_NAME=ks-example
INSTALL_NODE_IP=192.0.2.2

# 节点格式：name=IPv4，多节点使用逗号分隔。
MASTER_NODES=master-01=192.0.2.10,master-02=192.0.2.11,master-03=192.0.2.12
WORKER_NODES=worker-01=192.0.2.21,worker-02=192.0.2.22

SSH_USER=root
SSH_PORT=22
CHRONY_SERVERS=pool.ntp.org,time.cloudflare.com
CADDY_BIND=192.0.2.2
CADDY_PORT=2026
CADDY_ROOT=/srv/ks-deploy
CADDY_CONFIG_DIR=/etc/ks-deploy/caddy
CADDY_BIN_ROOT=/opt/ks-deploy/caddy

POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
CLUSTER_DNS=10.96.0.10
CLUSTER_DOMAIN=cluster.local
NODELOCAL_DNS_IP=169.254.20.10

CONTAINER_RUNTIME=containerd
PROXY_MODE=nftables
IMAGE_MODE=online
OFFLINE_MODE=false

HARBOR_ENABLED=false
HARBOR_NODE_IP=192.0.2.30
HARBOR_DOMAIN=harbor.192.0.2.30.nip.io
HARBOR_SCHEME=http
HARBOR_PROJECT=kubernetes

# 用户需求默认值；生产环境建议评估保留 SELinux Enforcing 和 firewalld。
SELINUX_DISABLE=true
FIREWALLD_UNINSTALL=true
SWAP_DISABLE=true

PKI_DIR=/etc/ks-deploy/pki
ARTIFACTS_ROOT=/srv/ks-deploy/artifacts
KUBELET_ROOT=/var/lib/kubelet
CONTAINERD_ROOT=/var/lib/containerd
DOCKER_ROOT=/var/lib/docker
ETCD_DATA_DIR=/var/lib/etcd

